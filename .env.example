# =============================================================================
# FX University — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development and fill in real values.
# NEVER commit .env.local (already gitignored) or any file with real secrets.
#
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser. Everything else
# is server-only and must never be referenced from a Client Component.
# =============================================================================

# --- Supabase -----------------------------------------------------------
# Project URL and publishable (anon) key — safe for the browser. Get these
# from Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY. Bypasses Row Level Security. Used only in
# server-only code (webhook handler, admin actions, service-role helpers).
# Never prefix with NEXT_PUBLIC_. Never send to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack -------------------------------------------------------------
# Secret key — SERVER ONLY. Used to initialize/verify transactions and to
# verify webhook signatures (HMAC-SHA512 of the raw request body). Use a
# test-mode secret key (sk_test_...) until go-live; switch to a live key
# (sk_live_...) only in production.
PAYSTACK_SECRET_KEY=

# --- Korapay ----------------------------------------------------------------
# Secret key — SERVER ONLY. Used to initialize/verify charges (Korapay's
# Checkout Redirect API) and to verify webhook signatures (HMAC-SHA256 of
# the JSON-serialized "data" object — see lib/payments/korapay.ts). Use a
# test-mode secret key until go-live; switch to a live key only in
# production. Paystack remains the default payment provider for new
# checkouts (see lib/payments/provider.ts) until an admin provider-
# switching UI is added, but this key is still required for the Korapay
# adapter/webhook route to function at all.
#
# No public/client-side Korapay key is needed: this app uses Korapay's
# server-initiated Checkout Redirect flow (a plain redirect to a Korapay-
# hosted page), not its client-side JS checkout modal, mirroring exactly
# how Paystack is integrated above.
KORAPAY_SECRET_KEY=

# TEMPORARY, for controlled Korapay test-mode verification only — see
# lib/payments/provider.ts's resolvePaymentProvider(). Server-only; never
# read by the browser. Leave unset (the normal/production state): new
# checkouts use Paystack. Set to exactly "korapay" (e.g. in Vercel's
# Preview/Development environment variables) to route new checkouts to
# Korapay instead, for testing. Any other value, or leaving this unset, is
# treated as Paystack — this is a deliberately safe default. No Production
# value should be set for this variable; Production must keep using the
# fallback (Paystack). This env var is a stand-in for the real admin
# provider-switching UI, which is separate, later work and is not built
# yet — it should be removed once that UI exists.
PAYMENT_PROVIDER=

# --- Application ------------------------------------------------------------
# Full public URL of this site, no trailing slash. Used to build the
# payment provider's callback/redirect URL and password-reset redirect
# links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Course pricing -----------------------------------------------------
# REQUIRED — there is no default. The existing pricing UI (lib/course-data.ts)
# ships with placeholder values ("XX"); checkout will fail loudly at request
# time if these are unset rather than silently charging an invented amount.
# Amount is in the currency's smallest unit (e.g. kobo for NGN, cents for USD),
# matching what Paystack's Initialize Transaction API expects.
COURSE_PRICE_MINOR_UNITS=
COURSE_PRICE_CURRENCY=

# Identifier used across course_access / orders rows for this course.
# Defaults to "fx-university" in code if unset — override only if the
# project introduces a different canonical course identifier.
COURSE_ID=fx-university
